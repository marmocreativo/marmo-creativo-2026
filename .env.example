# Copia este archivo como .env.local (desarrollo) y llena los valores.
# En producción (Docker) copia como .env junto al docker-compose.yml.

# --- Base de datos ---------------------------------------------------------
# Local (Laragon): host 127.0.0.1, usuario root, contraseña vacía (por defecto)
# Producción (docker-compose): usa un usuario propio (ej. DB_USER=marmo, NO root) y una DB_PASSWORD fuerte
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=marmo_creativo

# Solo producción: contraseña root del contenedor MySQL (docker-compose la usa)
DB_ROOT_PASSWORD=

# --- Auth.js ----------------------------------------------------------------
# Genera el secreto con:  npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=

# URL pública del sitio (local: http://localhost:3000)
AUTH_URL=http://localhost:3000

# Google OAuth: https://console.cloud.google.com/apis/credentials
# URI de redirección autorizada: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- IA para el blog (botón "Crear nota con IA" del admin) ---------------------------
# API key de Gemini: https://aistudio.google.com/apikey  (la búsqueda en Google y las imágenes consumen cuota/costo)
GEMINI_API_KEY=
# Opcionales: Google cambia seguido los modelos. Si uno se retira, pon aquí el nombre vigente
# (los valores por defecto están en lib/ia/gemini.ts).
# GEMINI_MODELO_TEXTO=
# GEMINI_MODELO_IMAGEN=
# GEMINI_API_REVISION=

# --- Imágenes subidas ----------------------------------------------------------
# Carpeta donde se guardan (por defecto ./uploads). En Docker ya apunta al volumen /app/uploads.
# UPLOAD_DIR=
